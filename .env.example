# The variables added in this file are only available locally in MiniOxygen.
# Run `h2 link` to also inject environment variables from your storefront,
# or `h2 env pull` to populate this file.
SESSION_SECRET=

PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STORE_DOMAIN=
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=
SHOP_ID=


# Authentication is the Shopify Customer Account API (the PUBLIC_CUSTOMER_*
# values above). The Microsoft Entra OIDC variables that used to live here —
# PUBLIC_ENTRA_ID_AUTHORITY, ENTRA_ID_CLIENT_ID, ENTRA_ID_CLIENT_SECRET,
# ENTRA_ID_REDIRECT_URI — were removed with the /auth/* routes and are no
# longer read anywhere. CLAUDE.md still specifies Entra as the identity
# provider, so they will return when that flow is rebuilt.


# Shopify Admin API — B2B Companies, draft orders, and all $app metafield and
# metaobject IO. Read only from *.server.ts modules; this token grants full
# store access and must never reach the client.

# Either the client-credentials pair from the custom app…
ADMIN_API_CLIENT_ID=
ADMIN_API_CLIENT_SECRET=

# …or a permanent custom-app token (shpat_…), which takes precedence when set.
ADMIN_API_ACCESS_TOKEN=

# Optional. Overrides the Admin API version the client defaults to.
ADMIN_API_VERSION=
